{
  "name": "siliconflower",
  "version": "0.2.6",
  "description": "CLI/TUI AI agent for Windows, Linux and Unix with MCP, reasoning control, skills, and OpenAI-compatible backends.",
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "type": "module",
  "license": "MIT",
  "author": "siliconflower contributors",
  "homepage": "https://github.com/1155dosilicon/siliconflower-nix#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/1155dosilicon/siliconflower-nix.git"
  },
  "bugs": {
    "url": "https://github.com/1155dosilicon/siliconflower-nix/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "tui",
    "mcp",
    "openai",
    "siliconflow",
    "openrouter",
    "reasoning",
    "tools",
    "ink",
    "bun"
  ],
  "bin": {
    "siliconflower": "bin/siliconflower.js"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run src/index.tsx",
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "install:bin": "node scripts/install-bin.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "@modelcontextprotocol/sdk": "^1.9.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "openai": "^4.73.0",
    "react": "^18.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "bun-types": "^1.2.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  }
}
